---
import { experience } from "../data/experience";

interface Props {
  index: string;
}

const { index } = Astro.props;
---

{experience.length > 0 && (
  <section id="experiencia" class="relative py-20 border-t border-border">
    <div class="mx-auto max-w-5xl px-6">
      <div class="flex items-baseline gap-3 mb-12">
        <span class="font-mono text-sm text-accent-bright">{index}</span>
        <h2 class="font-display font-semibold text-2xl sm:text-3xl text-text">
          Experiencia
        </h2>
      </div>

      <div class="flex flex-col gap-10">
        {experience.map((job) => (
          <div class="grid sm:grid-cols-[10rem_1fr] gap-x-6 gap-y-2">
            <span class="font-mono text-sm text-text-dim">
              {job.period}
            </span>
            <div>
              <h3 class="font-display font-semibold text-lg text-text">
                {job.role} <span class="text-text-muted font-normal">· {job.company}</span>
              </h3>
              <p class="mt-2 text-text-muted leading-relaxed max-w-2xl">
                {job.description}
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
)}
