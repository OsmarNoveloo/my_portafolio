---
import { social } from "../data/social";

const year = new Date().getFullYear();
---

<footer class="relative border-t border-border py-8">
  <div class="mx-auto max-w-5xl px-6 flex flex-col sm:flex-row items-center justify-between gap-4 font-mono text-xs text-text-dim">
    <span>© {year} {social.name}</span>
    <a href="#top" class="group inline-flex items-center gap-1 hover:text-text-muted transition-colors">
      Volver arriba
      <span class="inline-block transition-transform group-hover:-translate-y-0.5">↑</span>
    </a>
  </div>
</footer>
