---
import { social } from "../data/social";
---

<section id="top" class="relative pt-40 pb-24 sm:pt-48 sm:pb-32">
  <div class="mx-auto max-w-5xl px-6">
    <p data-reveal style="--reveal-delay: 0ms" class="font-mono text-sm text-accent-bright mb-6">
      // {social.role.toLowerCase()}
    </p>

    <h1 data-reveal style="--reveal-delay: 90ms" class="font-display font-semibold text-4xl sm:text-6xl leading-[1.05] tracking-tight text-balance text-text">
      {social.name}
    </h1>

    <p data-reveal style="--reveal-delay: 180ms" class="mt-6 max-w-xl text-lg text-text-muted leading-relaxed">
      Resuelvo problemas técnicos de punta a punta, tanto en frontend como en backend.
      Construyo sistemas de punto de venta, integraciones con inteligencia artificial y
      aplicaciones web completas, y sigo aprendiendo constantemente en el camino.
    </p>

    <div data-reveal style="--reveal-delay: 260ms" class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-2 font-mono text-sm text-text-dim">
      <span class="inline-flex items-center gap-2">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" />
          <circle cx="12" cy="10" r="3" />
        </svg>
        {social.location}
      </span>
      <span class="inline-flex items-center gap-2 text-emerald-400/80">
        <span class="h-1.5 w-1.5 rounded-full bg-emerald-400 animate-pulse-dot"></span>
        {social.availability}
      </span>
    </div>

    <div data-reveal style="--reveal-delay: 340ms" class="mt-10 flex flex-wrap items-center gap-4">
      <a
        href="#proyectos"
        class="rounded-md bg-accent px-5 py-2.5 text-sm font-medium text-white transition-all hover:bg-accent-bright hover:-translate-y-0.5 active:translate-y-0"
      >
        Ver proyectos
      </a>
      <a
        href={`mailto:${social.email}`}
        class="rounded-md border border-border px-5 py-2.5 text-sm font-medium text-text transition-all hover:border-accent hover:text-accent-bright hover:-translate-y-0.5 active:translate-y-0"
      >
        Contáctame
      </a>

      <div class="flex items-center gap-1 ml-2">
        <a
          href={social.github}
          target="_blank"
          rel="noreferrer"
          aria-label="GitHub"
          class="p-2 text-text-muted hover:text-text transition-colors"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.57.1.78-.25.78-.55 0-.27-.01-1.16-.02-2.11-3.2.7-3.88-1.36-3.88-1.36-.52-1.33-1.28-1.68-1.28-1.68-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.71 1.26 3.37.96.1-.75.4-1.26.73-1.55-2.56-.29-5.25-1.28-5.25-5.7 0-1.26.45-2.29 1.19-3.09-.12-.29-.52-1.47.11-3.06 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.79 0c2.2-1.49 3.17-1.18 3.17-1.18.64 1.59.24 2.77.12 3.06.74.8 1.18 1.83 1.18 3.09 0 4.43-2.69 5.4-5.26 5.69.42.36.78 1.08.78 2.18 0 1.57-.02 2.84-.02 3.23 0 .3.21.66.79.55A10.52 10.52 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z" />
          </svg>
        </a>
        <a
          href={social.linkedin}
          target="_blank"
          rel="noreferrer"
          aria-label="LinkedIn"
          class="p-2 text-text-muted hover:text-text transition-colors"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
            <path d="M20.45 20.45h-3.55v-5.57c0-1.33-.02-3.03-1.85-3.03-1.86 0-2.14 1.45-2.14 2.94v5.66H9.35V9h3.41v1.56h.05c.48-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29ZM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12ZM7.12 20.45H3.56V9h3.56v11.45Z" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>
