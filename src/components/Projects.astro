---
import { Image } from "astro:assets";
import { projects } from "../data/projects";

interface Props {
  index: string;
}

const { index } = Astro.props;
---

<section id="proyectos" class="relative py-20 border-t border-border">
  <div class="mx-auto max-w-5xl px-6">
    <div data-reveal class="flex items-baseline gap-3 mb-12">
      <span class="font-mono text-sm text-accent-bright">{index}</span>
      <h2 class="font-display font-semibold text-2xl sm:text-3xl text-text">
        Proyectos
      </h2>
    </div>

    <div class="flex flex-col">
      {projects.map((project, i) => (
        <article data-reveal data-spotlight style={`--reveal-delay: ${i * 70}ms`} class="group relative overflow-hidden grid sm:grid-cols-[3rem_1fr] gap-x-6 gap-y-3 py-8 border-b border-border transition-colors hover:border-border-hover">
          <div class="spotlight pointer-events-none absolute inset-0 -z-10 opacity-0 transition-opacity duration-300 group-hover:opacity-100" aria-hidden="true"></div>

          <span class="font-mono text-sm text-text-dim group-hover:text-accent-bright transition-colors">
            {project.index}
          </span>

          <div>
            <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
              <h3 class="font-display font-semibold text-xl text-text group-hover:text-accent-bright transition-colors">
                {project.title}
              </h3>
            </div>

            <p class="mt-3 max-w-2xl text-text-muted leading-relaxed">
              {project.description}
            </p>

            {project.image && (
              <div class="mt-5 max-w-2xl overflow-hidden rounded-lg border border-border bg-bg-elevated">
                <div class="flex items-center gap-1.5 px-3 py-2.5 border-b border-border">
                  <span class="h-2.5 w-2.5 rounded-full bg-border-hover"></span>
                  <span class="h-2.5 w-2.5 rounded-full bg-border-hover"></span>
                  <span class="h-2.5 w-2.5 rounded-full bg-border-hover"></span>
                </div>
                <Image
                  src={project.image}
                  alt={`Captura de ${project.title}`}
                  width={800}
                  class="w-full h-auto transition-transform duration-300 group-hover:scale-[1.02]"
                />
              </div>
            )}

            <div class="mt-4 flex flex-wrap gap-2">
              {project.tech.map((t) => (
                <span class="font-mono text-xs text-text-dim border border-border rounded px-2 py-1">
                  {t}
                </span>
              ))}
            </div>

            <div class="mt-4 flex items-center gap-5 font-mono text-sm">
              {project.demo && (
                <a
                  href={project.demo}
                  target="_blank"
                  rel="noreferrer"
                  class="inline-flex items-center gap-1.5 text-text-muted hover:text-accent-bright transition-colors"
                >
                  Ver demo
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5">
                    <path d="M7 17 17 7M7 7h10v10" />
                  </svg>
                </a>
              )}
              {project.code && (
                <a
                  href={project.code}
                  target="_blank"
                  rel="noreferrer"
                  class="inline-flex items-center gap-1.5 text-text-muted hover:text-accent-bright transition-colors"
                >
                  Código
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5">
                    <path d="M7 17 17 7M7 7h10v10" />
                  </svg>
                </a>
              )}
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  const cards = document.querySelectorAll("[data-spotlight]");

  cards.forEach((card) => {
    if (!(card instanceof HTMLElement)) return;

    let rect = card.getBoundingClientRect();
    let pendingX = 0;
    let pendingY = 0;
    let ticking = false;

    const applySpot = () => {
      ticking = false;
      card.style.setProperty("--spot-x", `${pendingX}px`);
      card.style.setProperty("--spot-y", `${pendingY}px`);
    };

    card.addEventListener("mouseenter", () => {
      rect = card.getBoundingClientRect();
    });

    card.addEventListener("mousemove", (e) => {
      pendingX = e.clientX - rect.left;
      pendingY = e.clientY - rect.top;
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(applySpot);
    });
  });
</script>
